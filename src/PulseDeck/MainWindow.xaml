<Window x:Class="PulseDeck.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PulseDeck" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="PulseDeck" Icon="Assets/PulseDeck.ico" Width="1440" Height="940" MinWidth="1060" MinHeight="720" Background="{StaticResource Background}" Foreground="{StaticResource Ink}" FontFamily="{StaticResource BodyFont}" FontSize="14" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" PreviewMouseMove="Scene_MouseMove" PreviewMouseDown="Scene_MouseDown" GotKeyboardFocus="Scene_KeyboardFocus">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
 <Border x:Name="WindowFrame" BorderBrush="{StaticResource Border}" BorderThickness="1" Background="{StaticResource Background}">
 <Grid x:Name="RootScene">
  <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
  <local:ConstellationField x:Name="Backdrop" Grid.RowSpan="3" IsHitTestVisible="False"/>
  <Border Grid.Row="0" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Background="{StaticResource Background}">
   <Grid Margin="20,0,8,0"><Grid.ColumnDefinitions><ColumnDefinition Width="196"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Path Data="M0,14 L9,14 14,2 20,27 26,14 36,14" Stroke="{StaticResource Cyan}" StrokeThickness="2.5" Width="36" Height="30" Margin="0,0,12,0"/><TextBlock Text="PulseDeck" FontFamily="{StaticResource DisplayFont}" FontSize="22" VerticalAlignment="Center"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Ellipse x:Name="ActivityDot" Width="6" Height="6" Fill="{StaticResource Cyan}" Margin="6,0,9,0"/><TextBlock x:Name="LiveState" Text="Conectando" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button Content="Comandos   Ctrl K" Click="OpenCommands_Click" Padding="12,6" MinHeight="32" Background="Transparent" Margin="0,0,10,0"/><Button x:Name="PauseButton" Content="Pausar" VerticalAlignment="Center" Click="Pause_Click" Padding="12,6" MinHeight="32" ToolTip="Ctrl + Espaço: pausar ou retomar leituras" Margin="0,0,16,0"/></StackPanel>
    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True"><Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" Content="─" Click="Minimize_Click" ToolTip="Minimizar" AutomationProperties.Name="Minimizar"/><Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="□" Click="Maximize_Click" ToolTip="Maximizar ou restaurar" AutomationProperties.Name="Maximizar ou restaurar"/><Button x:Name="CloseWindowButton" Style="{StaticResource CaptionButton}" Content="×" FontSize="22" Click="CloseWindow_Click" ToolTip="Fechar" AutomationProperties.Name="Fechar PulseDeck"/></StackPanel>
   </Grid>
  </Border>
  <TabControl x:Name="Navigation" Grid.Row="1" TabStripPlacement="Left" Background="Transparent" BorderThickness="0" SelectionChanged="Navigation_Changed">
   <TabItem Header="Visão geral">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,8,0">
     <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Visão geral" Style="{StaticResource Title}"/><TextBlock x:Name="HardwareLabel" Text="Lendo processador..." Style="{StaticResource Label}"/></StackPanel><Button Grid.Column="1" Content="Ventoinhas da GPU" Click="GoFans_Click" VerticalAlignment="Center"/></Grid>
     <UniformGrid Columns="4" Margin="0,0,-12,18">
      <local:ReactivePanel Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="Processador" Style="{StaticResource Label}"/><local:MetricDial x:Name="CpuMetricDial" Height="126"/><TextBlock x:Name="CpuValue" Visibility="Collapsed" Text="—" FontSize="36" FontFamily="{StaticResource DisplayFont}" Foreground="{StaticResource Cyan}"/><ProgressBar x:Name="CpuBar" Visibility="Collapsed" Maximum="100" Height="3" Margin="0,14,0,8" Foreground="{StaticResource Cyan}" Background="{StaticResource Border}"/><TextBlock Text="Uso total da CPU" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel></local:ReactivePanel>
      <local:ReactivePanel Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="Memória" Style="{StaticResource Label}"/><local:MetricDial x:Name="RamMetricDial" Height="126"/><TextBlock x:Name="RamValue" Visibility="Collapsed" Text="—" FontSize="36" FontFamily="{StaticResource DisplayFont}" Foreground="{StaticResource Purple}"/><ProgressBar x:Name="RamBar" Visibility="Collapsed" Maximum="100" Height="3" Margin="0,14,0,8" Foreground="{StaticResource Purple}" Background="{StaticResource Border}"/><TextBlock x:Name="RamDetail" Text="Memória física" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel></local:ReactivePanel>
      <local:ReactivePanel Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="Temperatura da GPU" Style="{StaticResource Label}"/><local:MetricDial x:Name="GpuTempMetricDial" Height="126"/><TextBlock x:Name="GpuTempValue" Visibility="Collapsed" Text="—" FontSize="36" FontFamily="{StaticResource DisplayFont}" Foreground="{StaticResource Amber}"/><TextBlock x:Name="GpuClockValue" Text="Clock indisponível" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,14,0,8"/><TextBlock x:Name="GpuLoadValue" Text="Consultando driver" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel></local:ReactivePanel>
      <local:ReactivePanel Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="Processos" Style="{StaticResource Label}"/><TextBlock x:Name="ProcessValue" Text="—" FontSize="36" FontFamily="{StaticResource DisplayFont}"/><TextBlock Text="Ativos no Windows" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,14,0,8"/><TextBlock Text="Lista por memória" FontSize="11" Foreground="{StaticResource Muted}"/></StackPanel></local:ReactivePanel>
     </UniformGrid>
     <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <local:ReactivePanel Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="190"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Pulso do sistema" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Últimos 120 segundos. Escala de 0 a 100%." Style="{StaticResource Label}" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><TextBlock Text="CPU" Foreground="{StaticResource Cyan}" FontSize="11" Margin="0,0,12,0"/><TextBlock Text="RAM" Foreground="{StaticResource Purple}" FontSize="11" Margin="0,0,12,0"/><TextBlock Text="GPU" Foreground="{StaticResource Amber}" FontSize="11"/></StackPanel></Grid><local:LiveChart x:Name="HistoryChart" Grid.Row="1"/><TextBlock x:Name="AdviceLabel" Grid.Row="2" Text="Aguardando leituras." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0"/></Grid></local:ReactivePanel>
      <local:ReactivePanel Grid.Column="1" Style="{StaticResource Card}" Margin="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Placa gráfica" Style="{StaticResource Label}"/><TextBlock x:Name="HeroGpuName" Text="Conectando ao driver" FontFamily="{StaticResource DisplayFont}" FontSize="20"/></StackPanel><local:TelemetryDial x:Name="GpuDial" Grid.Row="1" Height="160" Margin="0,8"/><Button Grid.Row="2" Content="Abrir ajustes da GPU" Click="GoOverclock_Click"/></Grid></local:ReactivePanel>
     </Grid>

     <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Aplicativos" Style="{StaticResource Title}"/><TextBlock Text="Descubra quem está consumindo seus recursos, em tempo real." Style="{StaticResource Label}"/></StackPanel></Grid>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="AppsLeader" Text="Aguardando leituras…" FontFamily="{StaticResource DisplayFont}" FontSize="22" Margin="0,0,0,5"/><TextBlock x:Name="AppsReadAt" Text="Atualização a cada 2 segundos" Style="{StaticResource Label}" Margin="0,0,0,14"/><TextBlock Text="VER CONSUMO POR" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,8"/><StackPanel Orientation="Horizontal" Margin="0,0,0,16"><RadioButton x:Name="AppsRamMetric" Style="{StaticResource PresetCard}" GroupName="AppMetric" IsChecked="True" Checked="AppsMetric_Changed" Width="140" Height="58" Margin="0,0,8,0"><TextBlock Text="RAM" FontSize="19" FontFamily="{StaticResource DisplayFont}" HorizontalAlignment="Center"/></RadioButton><RadioButton x:Name="AppsCpuMetric" Style="{StaticResource PresetCard}" GroupName="AppMetric" Checked="AppsMetric_Changed" Width="140" Height="58" Margin="0,0,8,0"><TextBlock Text="CPU" FontSize="19" FontFamily="{StaticResource DisplayFont}" HorizontalAlignment="Center"/></RadioButton><RadioButton x:Name="AppsGpuMetric" Style="{StaticResource PresetCard}" GroupName="AppMetric" Checked="AppsMetric_Changed" Width="140" Height="58" Margin="0"><TextBlock Text="GPU" FontSize="19" FontFamily="{StaticResource DisplayFont}" HorizontalAlignment="Center"/></RadioButton></StackPanel><local:ApplicationChart3D x:Name="AppsChart" Height="395"/><TextBlock Text="RAM: soma dos working sets. CPU: capacidade total. GPU: maior motor da GPU por PID, quando o Windows expõe a leitura. Selecione o executável para ver o PID na tabela abaixo." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,14,0,0"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Consumo por aplicativo" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Os valores abaixo permanecem disponíveis sem interação com o gráfico." Style="{StaticResource Label}" Margin="0,5,0,12"/><DataGrid x:Name="AppsGrid" Height="220" IsReadOnly="True" SelectionMode="Single"><DataGrid.Columns><DataGridTextColumn Header="Executável" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Processos" Binding="{Binding ProcessCount}" Width="100"/><DataGridTextColumn Header="CPU" Binding="{Binding Cpu}" Width="100"/><DataGridTextColumn Header="GPU" Binding="{Binding Gpu}" Width="120"/><DataGridTextColumn Header="Memória" Binding="{Binding Ram}" Width="120"/></DataGrid.Columns></DataGrid></StackPanel></Border>

     <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="210"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Aplicativos e processos" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Selecione uma linha para inspecionar." Style="{StaticResource Label}" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Buscar nome ou PID" Style="{StaticResource Label}"/><TextBox x:Name="ProcessSearch" TextChanged="ProcessSearch_Changed" AutomationProperties.Name="Buscar processo por nome ou PID"/></StackPanel></Grid><DataGrid x:Name="ProcessesGrid" Grid.Row="1" IsReadOnly="True" SelectionMode="Single" SelectionChanged="Process_Selected"><DataGrid.Columns><DataGridTextColumn Header="Processo" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="80"/><DataGridTextColumn Header="CPU" Binding="{Binding Cpu}" Width="90"/><DataGridTextColumn Header="Memória" Binding="{Binding Ram}" Width="110"/></DataGrid.Columns></DataGrid><TextBlock x:Name="ProcessDetail" Grid.Row="2" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"/></Grid></Border>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="Ventoinhas">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,8,0">
     <TextBlock Text="Ventoinhas" Style="{StaticResource Title}"/><TextBlock Text="Quatro perfis para a sua GPU. Selecione, revise e aplique." Style="{StaticResource Label}" Margin="0,0,0,22"/>
     <local:ReactivePanel Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><local:FanVisual x:Name="GpuFanVisual" Width="74" Height="74"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="FanGpuName" Text="GPU AMD" FontFamily="{StaticResource DisplayFont}" FontSize="24"/><TextBlock x:Name="FanSupportLabel" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,18,0"/></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock x:Name="FanRpmLabel" Text="RPM indisponível" Foreground="{StaticResource Cyan}" FontFamily="{StaticResource DisplayFont}" FontSize="20"/><TextBlock Text="RPM real do driver" Style="{StaticResource Label}" Margin="0,5,0,0"/><TextBlock Text="Animação: prévia do perfil" Style="{StaticResource Label}"/></StackPanel></Grid></local:ReactivePanel>
     <UniformGrid x:Name="FanPresets" Columns="4" Margin="0,4,-12,20">
      <RadioButton x:Name="NormalProfile" Style="{StaticResource PresetCard}" GroupName="GpuFanProfile" Tag="Normal" Checked="FanProfile_Checked" IsEnabled="False"><StackPanel><TextBlock Text="01" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock Text="Normal" FontFamily="{StaticResource DisplayFont}" FontSize="23" Margin="0,18,0,8"/><TextBlock Text="Curva lida ao abrir a sessão." Foreground="{StaticResource Muted}" FontSize="12" MinHeight="44"/></StackPanel></RadioButton>
      <RadioButton x:Name="MediumProfile" Style="{StaticResource PresetCard}" GroupName="GpuFanProfile" Tag="Medio" Checked="FanProfile_Checked" IsEnabled="False"><StackPanel><TextBlock Text="02" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock Text="Médio" FontFamily="{StaticResource DisplayFont}" FontSize="23" Margin="0,18,0,8"/><TextBlock Text="Mais ventilação em toda a curva." Foreground="{StaticResource Muted}" FontSize="12" MinHeight="44"/></StackPanel></RadioButton>
      <RadioButton x:Name="AdvancedProfile" Style="{StaticResource PresetCard}" GroupName="GpuFanProfile" Tag="Avancado" Checked="FanProfile_Checked" IsEnabled="False"><StackPanel><TextBlock Text="03" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock Text="Avançado" FontFamily="{StaticResource DisplayFont}" FontSize="23" Margin="0,18,0,8"/><TextBlock Text="Resposta mais forte, mais ruído." Foreground="{StaticResource Muted}" FontSize="12" MinHeight="44"/></StackPanel></RadioButton>
      <RadioButton x:Name="ExtraProfile" Style="{StaticResource PresetCard}" GroupName="GpuFanProfile" Tag="ExtraRapido" Checked="FanProfile_Checked" IsEnabled="False"><StackPanel><TextBlock Text="04" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock Text="Extra rápido" FontFamily="{StaticResource DisplayFont}" FontSize="23" Margin="0,18,0,8"/><TextBlock Text="Prioriza o fluxo de ar da GPU." Foreground="{StaticResource Muted}" FontSize="12" MinHeight="44"/></StackPanel></RadioButton>
     </UniformGrid>
     <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Prévia do perfil" FontSize="18" FontWeight="SemiBold"/><local:FanCurveVisual x:Name="FanCurvePreview" Height="180" Margin="0,16,20,0"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="FanProfileSummary" Text="Aguardando curva do driver." FontSize="17" FontFamily="{StaticResource DisplayFont}"/><TextBlock Text="Selecionar não altera a rotação. O envio ao driver acontece após sua confirmação." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,16"/><Button x:Name="ApplyFanButton" Content="Aplicar perfil" Style="{StaticResource Primary}" Click="ApplyFan_Click" IsEnabled="False"/><Button x:Name="UndoGpuButton" Content="Desfazer ajustes" Click="UndoGpu_Click" IsEnabled="False" Margin="0,10,0,0"/></StackPanel></Grid></Border>
     <Expander Header="Ver pontos da curva e limites do driver" Margin="0,0,0,18"><StackPanel Margin="0,16,0,0"><TextBlock x:Name="FanLimitsLabel" Style="{StaticResource Label}"/><DataGrid x:Name="FanCurveGrid" Height="220" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Temperatura (°C)" Binding="{Binding Temperature}" Width="*"/><DataGridTextColumn Header="Ventilação (%)" Binding="{Binding Speed}" Width="*"/></DataGrid.Columns></DataGrid><Button Content="Reler curva aplicada" Click="ReadCurve_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></Expander>
     <Border x:Name="BoardControls" Style="{StaticResource Card}" Visibility="Collapsed"><StackPanel><TextBlock Text="Ventoinhas detectadas" FontSize="22" FontFamily="{StaticResource DisplayFont}"/><TextBlock x:Name="BoardNameLabel" Style="{StaticResource Label}"/><TextBlock x:Name="BoardStatusLabel" Style="{StaticResource Label}"/><DataGrid x:Name="BoardSensorsGrid" Height="210" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Canal" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Origem" Binding="{Binding Category}" Width="110"/><DataGridTextColumn Header="Tipo" Binding="{Binding Type}" Width="100"/><DataGridTextColumn Header="Valor" Binding="{Binding Value}" Width="90"/></DataGrid.Columns></DataGrid><WrapPanel x:Name="BoardActions" Margin="0,12,0,0"><ComboBox x:Name="BoardChannelPicker" MinWidth="200" MaxWidth="320" AutomationProperties.Name="Canal de ventilação da placa-mãe"/><TextBox x:Name="BoardDutyInput" Text="60" Width="65" Margin="10,0" AutomationProperties.Name="Ventilação em porcentagem"/><Button x:Name="ApplyBoardButton" Content="Revisar canal (%)" Click="ApplyBoard_Click" IsEnabled="False"/><Button Content="Automático" Click="RestoreBoard_Click" Margin="10,0,0,0"/></WrapPanel></StackPanel></Border>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="Overclock">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,8,0">
     <TextBlock Text="Ajustes da GPU" Style="{StaticResource Title}"/><TextBlock Text="Clock atual, ajuste proposto e limites do driver no mesmo lugar." Style="{StaticResource Label}" Margin="0,0,0,22"/>
     <local:ReactivePanel Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="OcGpuName" Text="GPU AMD" FontFamily="{StaticResource DisplayFont}" FontSize="26"/><TextBlock x:Name="OcTelemetryLabel" Text="Lendo telemetria..." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,10,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="AMD ADLX" Foreground="{StaticResource Cyan}" VerticalAlignment="Center"/></Grid></local:ReactivePanel>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="ClockFieldLabel" Text="Ajuste de frequência (MHz)" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="OcGpuSupportLabel" Foreground="{StaticResource Muted}" Margin="0,8,0,22"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox x:Name="ClockInput" IsEnabled="False" FontFamily="{StaticResource DisplayFont}" FontSize="30" AutomationProperties.Name="Ajuste de frequência da GPU em MHz"/><StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="ClockRangeLabel" Foreground="{StaticResource Muted}"/><TextBlock Text="Esse valor é uma solicitação ao driver. O clock efetivo aparece na telemetria." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/></StackPanel></Grid><WrapPanel Margin="0,16,0,24"><Button Content="Referência: 0 MHz" Tag="0" Click="ClockDraft_Click" Margin="0,0,8,0"/><Button Content="+25 MHz" Tag="25" Click="ClockDraft_Click" Margin="0,0,8,0"/><Button Content="+50 MHz" Tag="50" Click="ClockDraft_Click"/></WrapPanel><WrapPanel><Button x:Name="ApplyClockButton" Content="Revisar e aplicar ajuste" Style="{StaticResource Primary}" Click="ApplyClock_Click" IsEnabled="False"/><Button x:Name="UndoClockButton" Content="Desfazer ajustes" Click="UndoGpu_Click" IsEnabled="False" Margin="10,0,0,0"/><Button x:Name="ResetGpuButton" Content="Padrão de fábrica" Click="ResetGpu_Click" IsEnabled="False" Margin="10,0,0,0"/></WrapPanel></StackPanel></Border>
     <TextBlock Text="Overclock pode causar instabilidade e perda de trabalho. Não há aplicação automática ao iniciar. A supervisão térmica permanece ativa durante os ajustes." Foreground="{StaticResource Muted}" FontSize="12" Margin="2,0,2,20"/>
     <Expander Header="Registro da sessão"><TextBox x:Name="SessionLog" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="150" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0"/></Expander>
    </StackPanel></ScrollViewer>
   </TabItem>
   <TabItem Header="Temporários">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Limpeza assistida" Style="{StaticResource Label}" Foreground="{StaticResource Cyan}"/><TextBlock Text="Arquivos temporários" Style="{StaticResource Title}"/><TextBlock Text="Analise, filtre e revise antes de enviar os arquivos à Lixeira." Style="{StaticResource Label}"/></StackPanel><StackPanel Grid.Row="1" Margin="0,12,0,16"><WrapPanel><Button x:Name="ScanButton" Content="Analisar temporários" Style="{StaticResource Primary}" Click="Scan_Click"/><Button x:Name="CancelScanButton" Content="Cancelar" Click="CancelScan_Click" IsEnabled="False" Margin="8,0"/><Button Content="Selecionar todos" Click="SelectAll_Click"/><Button Content="Limpar seleção" Click="ClearSelection_Click" Margin="8,0"/><ComboBox x:Name="AgePicker" Width="180" SelectedIndex="0" SelectionChanged="TempFilter_Changed" AutomationProperties.Name="Filtrar temporários por idade"><ComboBoxItem Content="Qualquer idade"/><ComboBoxItem Content="Mais de 1 dia"/><ComboBoxItem Content="Mais de 7 dias"/><ComboBoxItem Content="Mais de 30 dias"/></ComboBox></WrapPanel><TextBlock x:Name="TempStatusLabel" Text="Análise ainda não iniciada." Foreground="{StaticResource Muted}" Margin="0,12,0,0"/></StackPanel><DataGrid x:Name="TempGrid" Grid.Row="2" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="TempSelection_Changed"><DataGrid.Columns><DataGridTextColumn Header="ARQUIVO" Binding="{Binding Name}" Width="2*"/><DataGridTextColumn Header="TAMANHO" Binding="{Binding Size}" Width="100"/><DataGridTextColumn Header="MODIFICADO" Binding="{Binding Modified}" Width="155"/><DataGridTextColumn Header="PASTA" Binding="{Binding Folder}" Width="2*"/></DataGrid.Columns></DataGrid><Grid Grid.Row="3" Margin="0,16,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="TempSelectionLabel" Text="Nenhum arquivo selecionado" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><Button x:Name="RecycleButton" Grid.Column="1" Content="Revisar envio à Lixeira" Background="#71324E" Click="Recycle_Click" IsEnabled="False"/></Grid></Grid>
   </TabItem>
   <TabItem Header="Otimização"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,8,0"><TextBlock Text="Otimização do Windows" Style="{StaticResource Title}"/><TextBlock Text="Nove opções, incluindo Padrão do Windows. Revise as mudanças antes de aplicar." Style="{StaticResource Label}" Margin="0,0,0,22"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}" Margin="0,0,16,16"><StackPanel><TextBlock Text="PRESETS" Foreground="{StaticResource Cyan}" FontSize="12" Margin="0,0,0,12"/><ListBox x:Name="OptPresetList" Background="{StaticResource Surface}" Foreground="{StaticResource Ink}" BorderThickness="0" SelectionChanged="OptPreset_Changed" SelectedIndex="0" AutomationProperties.Name="Presets de otimização"><ListBoxItem Content="00  Padrão do Windows"/><ListBoxItem Content="01  Captura desligada"/><ListBoxItem Content="02  Modo de Jogo"/><ListBoxItem Content="03  Interface simples"/><ListBoxItem Content="04  Movimento reduzido"/><ListBoxItem Content="05  Menus diretos"/><ListBoxItem Content="06  Jogo focado"/><ListBoxItem Content="07  Visual leve"/><ListBoxItem Content="08  Máximo local"/></ListBox></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="OptTitle" Text="Selecione um preset" FontFamily="{StaticResource DisplayFont}" FontSize="24"/><TextBlock x:Name="OptDescription" Style="{StaticResource Label}" Margin="0,12,0,16"/><TextBlock Text="MUDANÇAS NESTE PC" Foreground="{StaticResource Cyan}" FontSize="12" Margin="0,0,0,10"/><TextBlock x:Name="OptChanges" Text="Aguardando seleção" FontSize="15" Margin="0,0,0,22"/><TextBlock x:Name="OptHardware" TextWrapping="Wrap" Style="{StaticResource Label}" Margin="0,0,0,20"/><TextBlock Text="Ganho em %: não estimado. O efeito depende do jogo, CPU, GPU e carga atual. Nenhum benchmark foi executado; porcentagens inventadas seriam enganosas." Foreground="{StaticResource Amber}" FontSize="12" Margin="0,0,0,24"/><WrapPanel><Button x:Name="OptApplyButton" Content="Revisar e aplicar" Style="{StaticResource Primary}" Click="OptApply_Click"/><Button x:Name="OptDefaultButton" Content="Padrão do Windows" Click="OptDefault_Click" Margin="10,0,0,0"/><Button x:Name="OptRestoreButton" Content="Restaurar meus ajustes" Click="OptRestore_Click" Margin="10,0,0,0"/></WrapPanel><TextBlock x:Name="OptStatus" Style="{StaticResource Label}" Margin="0,14,0,0"/></StackPanel></Border></Grid></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Overlay"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,8,0"><TextBlock Text="PulseDeck Overlay" Style="{StaticResource Title}"/><TextBlock Text="Escolha as leituras exibidas por cima dos aplicativos. Arraste o título do overlay para movê-lo." Style="{StaticResource Label}" Margin="0,0,0,22"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="MÉTRICAS" Foreground="{StaticResource Cyan}" FontSize="12" Margin="0,0,0,16"/><CheckBox x:Name="OverlayFps" Content="FPS real via PresentMon (captura por processo)" IsChecked="True" Click="OverlayOptions_Changed" Margin="0,0,0,14"/><TextBlock Text="Processo para FPS" Style="{StaticResource Label}"/><ComboBox x:Name="FpsTargetPicker" SelectionChanged="FpsTarget_Changed" MinWidth="260" MaxWidth="440" HorizontalAlignment="Left" Margin="0,0,0,8"/><TextBlock x:Name="FpsStatus" Text="Selecione um jogo. A captura começa quando o overlay estiver visível." Style="{StaticResource Label}" Margin="0,0,0,16"/><CheckBox x:Name="OverlayGpu" Content="Uso da GPU" IsChecked="True" Click="OverlayOptions_Changed" Margin="0,0,0,14"/><CheckBox x:Name="OverlayGpuTemp" Content="Temperatura da GPU" IsChecked="True" Click="OverlayOptions_Changed" Margin="0,0,0,14"/><CheckBox x:Name="OverlayCpu" Content="Uso da CPU" IsChecked="True" Click="OverlayOptions_Changed" Margin="0,0,0,14"/><CheckBox x:Name="OverlayCpuTemp" Content="Temperatura da CPU (quando houver sensor)" IsChecked="True" Click="OverlayOptions_Changed" Margin="0,0,0,14"/><CheckBox x:Name="OverlayRam" Content="Uso de RAM" IsChecked="True" Click="OverlayOptions_Changed" Margin="0,0,0,18"/><TextBlock x:Name="CpuTempStatus" Text="Consultando sensor da CPU..." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,14"/><Grid Margin="0,0,0,14" Width="340" HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Opacidade do fundo" Style="{StaticResource Label}"/><Slider x:Name="OverlayOpacitySlider" Minimum="55" Maximum="100" Value="90" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OverlayOpacity_Changed" AutomationProperties.Name="Opacidade do fundo do overlay"/></StackPanel><TextBlock x:Name="OverlayOpacityValue" Grid.Column="1" Text="90%" Foreground="{StaticResource Cyan}" Margin="14,0,0,0" VerticalAlignment="Center"/></Grid><Grid Margin="0,0,0,18" Width="340" HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Tamanho do overlay" Style="{StaticResource Label}"/><Slider x:Name="OverlaySizeSlider" Minimum="65" Maximum="120" Value="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OverlaySize_Changed" AutomationProperties.Name="Tamanho do overlay"/></StackPanel><TextBlock x:Name="OverlaySizeValue" Grid.Column="1" Text="100%" Foreground="{StaticResource Cyan}" Margin="14,0,0,0" VerticalAlignment="Center"/></Grid><WrapPanel><Button Content="Mostrar overlay" Style="{StaticResource Primary}" Click="ShowOverlay_Click"/><Button Content="Ocultar overlay" Click="HideOverlay_Click" Margin="10,0,0,0"/></WrapPanel><TextBlock x:Name="OverlayStatus" Style="{StaticResource Label}" Margin="0,14,0,0"/><TextBlock Text="Leituras locais do Windows e do driver AMD. O overlay não injeta código nos jogos; em tela cheia exclusiva pode não aparecer." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,14,0,0"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Sistema"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,8,0"><TextBlock Text="Seu sistema" Style="{StaticResource Title}"/><TextBlock Text="Compatibilidade real, fontes das leituras e preferências de movimento." Style="{StaticResource Label}" Margin="0,0,0,22"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="OcCpuName" Text="Processador" FontFamily="{StaticResource DisplayFont}" FontSize="22"/><TextBlock x:Name="CpuClockLabel" Style="{StaticResource Label}" Margin="0,8,0,12"/><TextBlock Text="O ajuste da CPU ainda não tem uma integração documentada de escrita. O painel de overclock mostra apenas os controles disponíveis da GPU." Foreground="{StaticResource Muted}" FontSize="12"/></StackPanel></Border><Border Style="{StaticResource Card}"><TextBlock x:Name="DiagnosticLabel" Text="Executando diagnóstico..." FontFamily="{StaticResource CodeFont}" FontSize="12"/></Border><WrapPanel Margin="0,0,0,24"><Button Content="Reverificar suporte" Click="Recheck_Click" Style="{StaticResource Primary}"/><Button Content="Exportar diagnóstico" Click="ExportDiagnostic_Click" Margin="10,0,0,0"/><CheckBox x:Name="MotionToggle" Content="Efeitos de movimento" IsChecked="True" VerticalAlignment="Center" Margin="22,0,0,0" Checked="Motion_Changed" Unchecked="Motion_Changed"/></WrapPanel><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Abertura do PulseDeck" FontSize="20" Margin="0,0,0,12"/><CheckBox x:Name="IntroToggle" Content="Mostrar introdução 3D ao iniciar" Foreground="{StaticResource Ink}" Checked="IntroPreference_Changed" Unchecked="IntroPreference_Changed"/><TextBlock Text="Dura cerca de 3 segundos. Enter ou Esc pula a abertura. Com efeitos de movimento desligados, o painel abre diretamente." Style="{StaticResource Label}" Margin="0,10,0,14"/><Button Content="Rever introdução" Click="ReplayIntro_Click" HorizontalAlignment="Left"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
  </TabControl>
  <Border Grid.Row="2" Background="{StaticResource Background}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0"><Grid Margin="20,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusLabel" Text="Inicializando serviços nativos..." Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,16,0"/><TextBlock Grid.Column="1" Text="Telemetria local" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/></Grid></Border>
  <Grid x:Name="CommandOverlay" Grid.RowSpan="3" Visibility="Collapsed" Background="#B0090C12" MouseDown="CommandOverlay_MouseDown"><Border Width="520" MaxHeight="500" VerticalAlignment="Top" Margin="0,110,0,0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="22"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Ir para…" FontFamily="{StaticResource DisplayFont}" FontSize="24"/><Button Grid.Column="1" Content="Esc" Click="CloseCommands_Click" MinHeight="30" Padding="8,4"/></Grid><TextBox x:Name="CommandSearch" AutomationProperties.Name="Filtrar comandos" TextChanged="CommandSearch_Changed" Margin="0,18,0,12"/><ListBox x:Name="CommandList" Background="{StaticResource Surface}" Foreground="{StaticResource Ink}" BorderThickness="0" MouseLeftButtonUp="CommandList_Activate" KeyDown="CommandList_KeyDown" MinHeight="200" DisplayMemberPath="Title"/><TextBlock Text="↑ ↓ para escolher. Enter para abrir. Esc para voltar." Style="{StaticResource Label}" Margin="0,14,0,0"/></StackPanel></Border></Grid>
